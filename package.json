{
  "name": "pg-guard-sql",
  "version": "0.1.0",
  "private": true,
  "description": "Run untrusted (LLM-written) SQL on Postgres safely: Postgres-parser AST allowlist + read-only role + RLS session settings + timeouts + row caps + audit. Library and MCP server.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pg-guard-sql-mcp": "dist/mcp/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/mcp/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/validate.test.ts test/policy.test.ts",
    "mcp": "tsx src/mcp/cli.ts",
    "attacks": "tsx scripts/attack-report.ts",
    "smoke": "npm run build && tsx scripts/smoke-stdio.ts",
    "demo:up": "docker compose -f demo/docker-compose.yml up -d --wait",
    "demo": "tsx demo/run-demo.ts",
    "demo:down": "docker compose -f demo/docker-compose.yml down -v"
  },
  "keywords": [
    "postgres",
    "sql",
    "text-to-sql",
    "mcp",
    "model-context-protocol",
    "llm",
    "security",
    "rls",
    "guardrails"
  ],
  "author": "Azizbek Siddikov",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azizbeksiddikov/pg-guard-sql.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "libpg-query": "^18.2.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pg-cursor": "^2.7.2",
    "pg-copy-streams": "^7.0.0",
    "pg-cursor": "^2.22.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^4.1.12"
  }
}
